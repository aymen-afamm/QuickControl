<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrim (tap to dismiss) -->
    <View
        android:id="@+id/panelScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <!-- Control Panel Container -->
    <LinearLayout
        android:id="@+id/panelContainer"
        android:layout_width="268dp"
        android:layout_height="match_parent"
        android:background="@drawable/panel_background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Panel Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/panel_title"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:layout_marginBottom="18dp" />

        <!-- Lock Screen Button -->
        <LinearLayout
            android:id="@+id/btnLockScreen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="@string/lock_screen"
                android:layout_marginEnd="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_screen"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Power Menu Button -->
        <LinearLayout
            android:id="@+id/btnPowerMenu"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_power"
                android:contentDescription="@string/power_menu"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/power_menu"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/power_menu_subtitle"
                    android:textColor="@color/secondary_text"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Volume Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/btnVolumeDown"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_down"
                    android:contentDescription="@string/volume_down"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_down"
                    android:textColor="@color/primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnVolumeUp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/button_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_volume_up"
                    android:contentDescription="@string/volume_up"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_up"
                    android:textColor="@color/primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Volume Slider Card / Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/button_background"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_volume_up"
                android:tint="@color/secondary_text"
                android:contentDescription="Volume Slider" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary"
                android:progressBackgroundTint="@color/divider" />

            <TextView
                android:id="@+id/volumeLevel"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/primary_text"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="0" />
        </LinearLayout>

        <!-- Mute Button -->
        <LinearLayout
            android:id="@+id/btnMute"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/muteIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_volume_mute"
                android:contentDescription="@string/mute"
                android:layout_marginEnd="14dp" />

            <TextView
                android:id="@+id/muteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mute"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Flashlight Button -->
        <LinearLayout
            android:id="@+id/btnFlashlight"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/button_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/flashlightIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_flashlight"
                android:contentDescription="@string/flashlight"
                android:layout_marginEnd="14dp" />

            <TextView
                android:id="@+id/flashlightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/flashlight"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Settings Shortcut Button -->
        <LinearLayout
            android:id="@+id/btnOpenSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_secondary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings_title"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="@color/secondary_text"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
